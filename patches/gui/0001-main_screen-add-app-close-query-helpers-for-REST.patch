From 7e03d307836e17adb2ac280a2ed483f0402a99ee Mon Sep 17 00:00:00 2001
From: CybrX <cybrx@users.noreply.github.com>
Date: Mon, 5 Oct 2026 19:28:37 -0400
Subject: [PATCH 1/3] main_screen: add app close/query helpers for REST

Adds main_screen_close_app() and main_screen_current_app() used by cybr_http.
---
 src/main_screen.c | 40 +++++++++++++++++++++++++++++++---------
 src/main_screen.h |  6 ++++++
 2 files changed, 37 insertions(+), 9 deletions(-)

diff --git a/src/main_screen.c b/src/main_screen.c
index 6adce50..3696f7f 100644
--- a/src/main_screen.c
+++ b/src/main_screen.c
@@ -155,6 +155,26 @@ static void apps_disable() {
     panel_update_visibility(false);
 }
 
+void main_screen_close_app(void) {
+    /* Same close path main_screen_start_app() uses before opening an app. */
+    apps_disable();
+}
+
+const char *main_screen_current_app(void) {
+    if (dialog_type_is_run(dialog_ft8)) return "ft8";
+    if (dialog_type_is_run(dialog_swrscan)) return "swr";
+    if (dialog_type_is_run(dialog_gps)) return "gps";
+    if (dialog_type_is_run(dialog_recorder)) return "recorder";
+    if (dialog_type_is_run(dialog_settings)) return "settings";
+    if (dialog_type_is_run(dialog_callsign)) return "callsign";
+    if (dialog_type_is_run(dialog_qth)) return "qth";
+    if (dialog_type_is_run(dialog_wifi)) return "wifi";
+    if (rtty_get_state() != RTTY_OFF) return "rtty";
+    /* Some other dialog (freq, CW/voice msg, ...) is up; not one of the apps. */
+    if (dialog_is_run()) return "unknown";
+    return "none";
+}
+
 void main_screen_start_app(press_action_t app_action) {
     apps_disable();
 
@@ -196,6 +216,16 @@ void main_screen_start_app(press_action_t app_action) {
             voice_say_text_fmt("Wi-Fi window");
             break;
 
+        case ACTION_APP_QTH:
+            dialog_construct(dialog_qth, obj);
+            voice_say_text_fmt("QTH window");
+            break;
+
+        case ACTION_APP_CALLSIGN:
+            dialog_construct(dialog_callsign, obj);
+            voice_say_text_fmt("Callsign window");
+            break;
+
         default:
             break;
     }
@@ -262,17 +292,9 @@ void main_screen_action(press_action_t action) {
         case ACTION_APP_SETTINGS:
         case ACTION_APP_RECORDER:
         case ACTION_APP_WIFI:
-            main_screen_start_app(action);
-            break;
-
         case ACTION_APP_QTH:
-            dialog_construct(dialog_qth, obj);
-            voice_say_text_fmt("QTH window");
-            break;
-
         case ACTION_APP_CALLSIGN:
-            dialog_construct(dialog_callsign, obj);
-            voice_say_text_fmt("Callsign window");
+            main_screen_start_app(action);
             break;
     }
 }
diff --git a/src/main_screen.h b/src/main_screen.h
index f0314b6..897397a 100644
--- a/src/main_screen.h
+++ b/src/main_screen.h
@@ -24,6 +24,12 @@ lv_obj_t * main_screen(lv_obj_t *overlay_scr);
 void main_screen_start_app(press_action_t page_app);
 void main_screen_action(press_action_t action);
 
+/* Close the current dialog / RTTY app using apps_disable(). */
+void main_screen_close_app(void);
+
+/* LVGL thread only. "none", a known app name, or "unknown". */
+const char *main_screen_current_app(void);
+
 void main_screen_set_freq(uint64_t f);
 
 void mem_load(uint16_t id);
-- 
