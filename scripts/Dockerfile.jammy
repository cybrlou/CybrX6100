# Ubuntu 22.04 build env for AetherX6100Buildroot (from CybrX lab helpers; cmake 3.28.3 pin).
FROM ubuntu:22.04
ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC
RUN apt-get update && apt-get install -y locales git build-essential wget cpio unzip rsync bc \
    libncurses5-dev file cmake python3 python3-dev python3-setuptools python3-pip ninja-build \
    pkg-config libssl-dev libbluetooth-dev ca-certificates sqlite3 sudo && \
    localedef -i en_US -c -f UTF-8 -A /usr/share/locale/locale.alias en_US.UTF-8 && \
    useradd -u 1000 -m builder
RUN pip3 install --no-cache-dir "cmake==3.28.3"
ENV LANG=en_US.utf8
USER builder
